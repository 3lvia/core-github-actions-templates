{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:dockerfileVersions",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "minimumReleaseAge": "3 days",
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/.*\\.ya?ml$"],
      "matchStrings": ["prettier@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "prettier",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "fileMatch": ["^arc/Dockerfile$"],
      "matchStrings": ["ARG TRIVY_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "aquasecurity/trivy",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchDepTypes": ["action"],
      "matchPackageNames": [
        "3lvia/core-github-actions-templates",
        "3lvia/cli",
        "3lvia/gh-actions-docs"
      ],
      "pinDigests": false
    },
    {
      "matchPackageNames": ["aquasecurity/trivy"],
      "prBodyNotes": [
        "Update `TRIVY_CHECKSUM` with the SHA256 for the new `trivy_<version>_Linux-64bit.tar.gz` release asset."
      ]
    },
    {
      "matchPackageNames": ["mikefarah/yq"],
      "prBodyNotes": [
        "Update `YQ_CHECKSUM` with the SHA256 for the new `yq_linux_amd64` release asset."
      ]
    }
  ]
}
